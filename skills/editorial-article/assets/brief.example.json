          {"type": "paragraph", "text": "Żądanie zapisuje zadanie w [term:queue|kolejce]. Worker przetwarza je później."},
          {"type": "comparison", "items": [
            {"title": "Żądanie", "text": "Przyjmuje zadanie.", "caption": "Potwierdzenie", "icon": "plus-circle"},
            {"title": "Worker", "text": "Przetwarza przyjęte zadanie.", "caption": "Praca w tle", "icon": "cpu"}
          ]},
          {"type": "note", "text": "Realny artykuł może wskazać modele, o których opowiada. Poniższe odnośniki są poglądowe: demonstracja nie łączy się z żadną usługą, a linki prowadzą do oficjalnych stron."},
          {"type": "models", "items": [
            {"model": "GPT", "icon": "brand-openai", "note": "OpenAI", "url": "https://openai.com/"},
            {"model": "Gemini", "icon": "brand-googlegemini", "note": "Google DeepMind", "url": "https://deepmind.google/models/gemini/"},
            {"model": "Claude", "icon": "brand-anthropic", "note": "Anthropic", "url": "https://www.anthropic.com/claude"},
            {"model": "Mistral", "icon": "brand-mistralai", "note": "Mistral AI", "url": "https://mistral.ai/"}
          ]}
        ]},
        {"id": "process", "title": "Dwa krótkie procesy", "blocks": [
          {"type": "pipeline", "title": "Zadanie w kolejce", "caption": "Schemat poglądowy, nie telemetria.", "flows": {
            "capture": {"label": "Przyjmij", "steps": [
              {"title": "Odbierz", "heading": "Odbierz żądanie", "text": "Klient zgłasza zadanie.", "icon": "plugs-connected"},
              {"title": "Zapisz", "heading": "Zapisz zadanie", "text": "Kolejka przechowuje je do przetworzenia.", "icon": "tray"},
              {"title": "Potwierdź", "heading": "Potwierdź przyjęcie", "text": "Żądanie może zakończyć się przed przetwarzaniem.", "icon": "check-circle"}
            ]},
            "process": {"label": "Przetwórz", "steps": [
              {"title": "Podejmij", "heading": "Podejmij zadanie", "text": "Worker pobiera zadanie z kolejki.", "icon": "cpu"},
              {"title": "Zakończ", "heading": "Zapisz zakończenie", "text": "Worker zapisuje wynik.", "icon": "database"}
            ]}
          }}
